                  "Children": [
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.Soils;",
                        "using System;",
                        "using System.Linq;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "",
                        "    public class Script : Model",
                        "    {",
                        "        [Link]",
                        "        private Clock clock;",
                        "",
                        "        [Link]",
                        "        private IPlant crop;",
                        "",
                        "        [EventSubscribe(\"EndOfDay\")]",
                        "        private void OnDoCalculations(object sender, EventArgs e)",
                        "        {",
                        "            if (crop.IsReadyForHarvesting)",
                        "            {",
                        "                crop.Harvest();",
                        "                crop.EndCrop();",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [],
                      "Name": "Harvesting rule",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using APSIM.Numerics;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.Interfaces;",
                        "using Models.Soils;",
                        "using Models.PMF;",
                        "using Models.Core;",
                        "using System.Collections.Generic;",
                        "using System;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Clock Clock = null;",
                        "        [Link] private Summary Summary = null;",
                        "        [Link] private ISoilWater waterBalance = null;",
                        "        [Link] private IWeather Weather = null;",
                        "        [Link] private Zone paddock = null;",
                        "        [Link] private Plant Crop = null;",
                        "        [Link] private Soil Soil = null;",
                        "        [Link] private Physical physical = null;",
                        "",
                        "        [Description(\"Start of sowing window (d-mmm)\")]",
                        "        public string StartDate { get; set; } = \"01-Dec\";",
                        "",
                        "        [Description(\"End of sowing window (d-mmm)\")]",
                        "        public string EndDate { get; set; } = \"05-Dec\";",
                        "",
                        "        [Description(\"Minimum extractable soil water for sowing (mm)\")]",
                        "        public double MinESW { get; set; } = 0;",
                        "",
                        "        [Description(\"Accumulated rainfall required for sowing (mm)\")]",
                        "        public double MinRain { get; set; } = 0;",
                        "",
                        "        [Description(\"Duration of rainfall accumulation (days)\")]",
                        "        public int RainDays { get; set; } = 1;",
                        "",
                        "        [Display(Type = DisplayType.CultivarName)]",
                        "        [Description(\"Cultivar to be sown\")]",
                        "        public string CultivarName { get; set; } = \"Default\";",
                        "",
                        "        [Description(\"Sowing depth (mm)\")]",
                        "        public double SowingDepth { get; set; } = 30;",
                        "",
                        "        [Description(\"Row spacing (mm)\")]",
                        "        public double RowSpacing { get; set; } = 760;",
                        "",
                        "        [Description(\"Sowing density (/m2)\")]",
                        "        public double Density { get; set; } = 2.5;",
                        "",
                        "        [Description(\"Fraction of PAWC to set at sowing (0-1)\")]",
                        "        public double PAWCFraction { get; set; } = 1.0;",
                        "",
                        "        public enum RowConfigurationType { Solid, SingleSkip, DoubleSkip }",
                        "        public enum TilleringMethodType { RuleOfThumb = -1, FixedTillering = 0, DynamicTillering = 1 }",
                        "        [Description(\"Skip row configuration\")]",
                        "        public RowConfigurationType RowConfiguration { get; set; } = RowConfigurationType.Solid;",
                        "        [Description(\"Tillering method\")]",
                        "        public TilleringMethodType TilleringMethod { get; set; } = TilleringMethodType.DynamicTillering;",
                        "        [Description(\"Fertile tiller number\")]",
                        "        public double Ftn { get; set; } = 1.0;",
                        "",
                        "        private Queue<double> rainWindow;",
                        "        private double rainSum;",
                        "",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnSimulationCommencing(object sender, EventArgs e)",
                        "        {",
                        "            rainWindow = new Queue<double>(Math.Max(1, RainDays));",
                        "            rainSum = 0;",
                        "        }",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            double todayRain = Weather?.Rain ?? 0.0;",
                        "            rainWindow.Enqueue(todayRain);",
                        "            rainSum += todayRain;",
                        "            while (rainWindow.Count > Math.Max(1, RainDays))",
                        "                rainSum -= rainWindow.Dequeue();",
                        "",
                        "            bool inWindow = DateUtilities.WithinDates(StartDate, Clock.Today, EndDate);",
                        "            bool cropNotAlive = (Crop != null && !Crop.IsAlive);",
                        "",
                        "            if (inWindow && cropNotAlive)",
                        "            {",
                        "                // Reset soil water to specified PAWC fraction, filled from top",
                        "                double[] thickness = physical.Thickness;",
                        "                double[] dul = physical.DUL;",
                        "                double[] ll15 = physical.LL15;",
                        "                double[] newSW = new double[thickness.Length];",
                        "                for (int i = 0; i < thickness.Length; i++)",
                        "                    newSW[i] = ll15[i];  // Start at wilting point",
                        "",
                        "                // Calculate total PAWC",
                        "                double totalPAWC = 0;",
                        "                for (int i = 0; i < thickness.Length; i++)",
                        "                    totalPAWC += (dul[i] - ll15[i]) * thickness[i];",
                        "",
                        "                double targetPAW = totalPAWC * PAWCFraction;",
                        "                double remaining = targetPAW;",
                        "",
                        "                // Fill from top",
                        "                for (int i = 0; i < thickness.Length; i++)",
                        "                {",
                        "                    double layerPAWC = (dul[i] - ll15[i]) * thickness[i];",
                        "                    if (remaining >= layerPAWC)",
                        "                    {",
                        "                        newSW[i] = dul[i];",
                        "                        remaining -= layerPAWC;",
                        "                    }",
                        "                    else",
                        "                    {",
                        "                        newSW[i] = ll15[i] + remaining / thickness[i];",
                        "                        remaining = 0;",
                        "                    }",
                        "                }",
                        "",
                        "                // Apply the new soil water - set whole array",
                        "                waterBalance.SW = newSW;",
                        "                Summary.WriteMessage(this, ",
                        "                    $\"Soil water reset to {PAWCFraction*100:F0}% PAWC ({targetPAW:F0} mm of {totalPAWC:F0} mm total)\", ",
                        "                    Models.Core.MessageType.Information);",
                        "",
                        "                double population = Density * paddock.Area;",
                        "                Crop.Sow(",
                        "                    cultivar: CultivarName,",
                        "                    population: population,",
                        "                    depth: SowingDepth,",
                        "                    rowSpacing: RowSpacing,",
                        "                    rowConfig: (double)RowConfiguration,",
                        "                    tillering: (int)TilleringMethod,",
                        "                    ftn: Ftn",
                        "                );",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "StartDate",
                          "Value": "15-dec"
                        },
                        {
                          "Key": "EndDate",
                          "Value": "15-dec"
                        },
                        {
                          "Key": "MinESW",
                          "Value": "0"
                        },
                        {
                          "Key": "MinRain",
                          "Value": "0"
                        },
                        {
                          "Key": "RainDays",
                          "Value": "1"
                        },
                        {
                          "Key": "CultivarName",
                          "Value": ""
                        },
                        {
