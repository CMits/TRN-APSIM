                        },
                        {
                          "Key": "TilleringMethod",
                          "Value": "DynamicTillering"
                        },
                        {
                          "Key": "Ftn",
                          "Value": "1"
                        }
                      ],
                      "Name": "SowingRule",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
