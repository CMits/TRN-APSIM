                },
                {
                  "$type": "Models.Surface.SurfaceOrganicMatter, Models",
                  "SurfOM": [],
                  "Canopies": [],
                  "InitialResidueName": "wheat_stubble",
                  "InitialResidueType": "wheat",
                  "InitialResidueMass": 0.0,
                  "InitialStandingFraction": 0.0,
                  "InitialCPR": 0.0,
                  "InitialCNR": 80.0,
                  "Name": "SurfaceOrganicMatter",
                  "ResourceName": "SurfaceOrganicMatter",
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Numerics;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Interfaces;",
                    "using Models.Core;",
                    "using System;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        // ---- Links ----",
                    "        [Link] private Zone zone = null;",
                    "        [Link] private Irrigation irrigation = null;",
                    "        [Link] private Soil soil = null;",
                    "        [Link] private IPhysical soilPhysical = null;",
                    "        [Link] private ISoilWater waterBalance = null;",
                    "        [Link] private Clock Clock = null;",
                    "",
                    "        [Description(\"Crop to irrigate\")]",
                    "        public IPlant Crop { get; set; }",
                    "",
                    "        // ---- Settings ----",
                    "        [Description(\"Auto irrigation on?\")]",
                    "        public bool AutoIrrigationOn { get; set; } = true;",
                    "",
                    "        [Description(\"Threshold fraction available water (0-1)\")]",
                    "        public double FASWThreshold { get; set; } = 0.4;",
                    "",
                    "        [Description(\"Soil depth (mm) to which FASW is calculated\")]",
                    "        public double FASWDepth { get; set; } = 600;",
                    "",
                    "        [Description(\"Minimum weeks between irrigations\")]",
                    "        public double weeks { get; set; } = 2;",
                    "",
                    "        [Description(\"Minimum days after sowing for first irrigation\")]",
                    "        public int afterSowing { get; set; } = 7;",
                    "",
                    "        // ---- Outputs (optional to Report) ----",
                    "        public double FASW { get; set; }",
                    "        public double WaterDeficit { get; set; }",
                    "",
                    "        // ---- Internals ----",
                    "        private int daysSinceSowing = int.MaxValue;",
                    "        private int daysSinceLastIrr = int.MaxValue;",
                    "        private bool prevAlive = false;",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            // Track days since sowing",
                    "            bool alive = Crop != null && Crop.IsAlive;",
                    "",
                    "            // Detect sowing moment (transition to alive)",
                    "            if (alive && !prevAlive)",
                    "                daysSinceSowing = 0;",
                    "",
                    "            prevAlive = alive;",
                    "",
                    "            if (alive && daysSinceSowing < int.MaxValue)",
                    "                daysSinceSowing++;",
                    "",
                    "            if (daysSinceLastIrr < int.MaxValue)",
                    "                daysSinceLastIrr++;",
                    "",
                    "            if (AutoIrrigationOn && alive)",
                    "            {",
                    "                CalculateFASW();",
                    "",
                    "                int minGapDays = (int)Math.Round(weeks * 7.0);",
                    "                bool waitedAfterSowing = daysSinceSowing >= afterSowing;",
                    "                bool gapOk = daysSinceLastIrr >= minGapDays;",
                    "",
                    "                if (waitedAfterSowing && gapOk && FASW < FASWThreshold && WaterDeficit > 0)",
                    "                {",
                    "                    irrigation.Apply(WaterDeficit, depth: 0);",
                    "                    daysSinceLastIrr = 0;",
                    "                }",
                    "            }",
                    "            else",
                    "            {",
                    "                // Prime the counter so first possible irrigation won\u00c3\u00a2\u00e2\u201a\u00ac\u00e2\u201e\u00a2t happen until afterSowing and the min gap.",
                    "                int minGapDays = (int)Math.Round(weeks * 7.0);",
                    "                int init = minGapDays - afterSowing - 1;",
                    "                if (init < 0) init = 0;",
                    "                daysSinceLastIrr = init;",
                    "            }",
                    "        }",
                    "",
                    "",
                    "        // Calculate FASW (0..1) to FASWDepth and the mm deficit to DUL",
                    "        private void CalculateFASW()",
                    "        {",
                    "            // Layer-wise amounts in mm",
                    "            double[] LL15mm = MathUtilities.Multiply(soilPhysical.LL15, soilPhysical.Thickness);",
                    "            double[] DULmm  = MathUtilities.Multiply(soilPhysical.DUL,  soilPhysical.Thickness);",
                    "",
                    "            int nlay = GetLayerIndex(FASWDepth); // index of layer containing FASWDepth",
                    "            nlay = MathUtilities.Constrain(nlay, 0, soilPhysical.Thickness.Length - 1);",
                    "",
                    "            double cumAbove = MathUtilities.Sum(soilPhysical.Thickness, 0, nlay, 0.0);",
                    "            double remaining = Math.Max(0.0, FASWDepth - cumAbove);",
                    "            double fracPart = MathUtilities.Divide(remaining, soilPhysical.Thickness[nlay], 0.0);",
                    "            fracPart = MathUtilities.Constrain(fracPart, 0.0, 1.0);",
                    "",
                    "            double swmm    = MathUtilities.Sum(waterBalance.SWmm, 0, nlay, 0.0) + fracPart * waterBalance.SWmm[nlay];",
                    "            double ll15mm  = MathUtilities.Sum(LL15mm,            0, nlay, 0.0) + fracPart * LL15mm[nlay];",
                    "            double dulmm   = MathUtilities.Sum(DULmm,             0, nlay, 0.0) + fracPart * DULmm[nlay];",
                    "",
                    "            double avail    = Math.Max(0.0, swmm - ll15mm);",
                    "            double potAvail = Math.Max(0.0, dulmm - ll15mm);",
                    "",
                    "            FASW = MathUtilities.Divide(avail, potAvail, 0.0);",
                    "            FASW = MathUtilities.Constrain(FASW, 0.0, 1.0);",
                    "",
                    "            WaterDeficit = MathUtilities.Constrain(potAvail - avail, 0.0, 1e6);",
                    "        }",
                    "",
                    "        // Index of layer that contains the given depth (mm)",
                    "        private int GetLayerIndex(double pointDepth)",
                    "        {",
                    "            var cum = soilPhysical.ThicknessCumulative;",
                    "            int i = 0;",
                    "            while (i < cum.Length && pointDepth > cum[i]) i++;",
                    "            if (i >= cum.Length) i = cum.Length - 1;",
                    "            return i;",
                    "        }",
                    "    }",
                    "}",
                    ""
                  ],
                  "Parameters": null,
                  "Name": "Automatic irrigation based on water deficit",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": false,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Core;",
                    "using Models.PMF;",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] Clock Clock;",
                    "        [Link] Fertiliser Fertiliser;",
                    "        ",
                    "        [Description(\"Crop to be fertilised\")]",
                    "        public IPlant Crop { get; set; }",
                    "",
                    "        [Description(\"Type of fertiliser to apply? \")] ",
                    "        [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                    "    ",
                    "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                    "        public double Amount { get; set; }",
                    "        ",
                    "        [EventSubscribe(\"Sowing\")]",
                    "        private void OnSowing(object sender, EventArgs e)",
                    "        {",
                    "            Model crop = sender as Model;",
                    "            if (Crop != null && crop.Name.ToLower() == (Crop as IModel).Name.ToLower())",
                    "                Fertiliser.Apply(amount: Amount, type: FertiliserType);",
                    "        }",
                    "    }",
                    "}"
                  ],
